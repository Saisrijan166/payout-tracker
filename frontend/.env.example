# Copy to frontend/.env.local for local development.
# This is the only variable the web app reads.

# Base URL of the backend API, including /api.
# Next.js inlines NEXT_PUBLIC_* values at build time, so rebuild after changing it.
# Production (Vercel) uses https://memed-payouts-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
