# Copy to backend/.env for local development. Real environment variables take precedence.
# Every variable the API reads is listed here; only MONGODB_URI and JWT_SECRET are required.

# Runtime: development | test | production
NODE_ENV=development
# HTTP port. Render sets PORT itself in production.
PORT=4000

# Required. MongoDB must run as a replica set because payouts use transactions.
# Local Docker (see README): mongodb://localhost:27017/memed?directConnection=true
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memed?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/memed?directConnection=true

# Required. JWT signing secret, at least 32 characters. Generate one with:
#   openssl rand -hex 32
# Left empty on purpose: the API will not start until you set your own.
JWT_SECRET=
# Token lifetime: a number followed by s, m, h or d
JWT_EXPIRES_IN=1d
# bcrypt cost factor (4-15)
BCRYPT_ROUNDS=10

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Optional Redis for caching the live campaign list. Leave empty to disable the cache.
# Local Docker: redis://localhost:6379
REDIS_URL=
CAMPAIGN_CACHE_TTL_SECONDS=30

# View-spike flag: a submission is flagged when it gains at least SPIKE_MIN_GAIN views
# at SPIKE_VIEWS_PER_MIN or faster since its previous reading.
SPIKE_MIN_GAIN=10000
SPIKE_VIEWS_PER_MIN=1000

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Optional, read only by the seed script (npm run seed / seed:prod):
# password for the demo accounts it creates. Defaults to Password123!
# SEED_PASSWORD=

# Optional, read only by the tests: a running Redis enables the real-Redis cache tests
# (they are skipped otherwise), e.g. redis://localhost:6379
# TEST_REDIS_URL=
