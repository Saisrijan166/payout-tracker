# Runtime: development | test | production
NODE_ENV=development
PORT=4000

# MongoDB must run as a replica set because payouts use transactions.
# Local Docker (see README): mongodb://localhost:27017/memed?directConnection=true
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memed?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/memed?directConnection=true

# JWT signing secret: at least 32 random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Token lifetime: a number followed by s, m, h or d
JWT_EXPIRES_IN=1d
# bcrypt cost factor (4-15)
BCRYPT_ROUNDS=10

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Optional Redis for caching the live campaign list. Leave empty to disable.
# Local Docker: redis://localhost:6379
REDIS_URL=
CAMPAIGN_CACHE_TTL_SECONDS=30

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
